<%- include("partials/header.ejs") %>

<div class="book_review">
    <div class="book_data">
        <% if (locals.book){%>
            <h2><%= book.title %></h2>
            <img class="cover_img" src="https://covers.openlibrary.org/b/id/<%= book.cover_id %>-M.jpg" />
            <p><%= book.author_name %>, <%= book.first_publish_year %></p>
        <% } %>
    </div>
    <h2>Add Information about the book</h2>
    <form class="form_review" action="/new" method="post">
        <% if (locals.book){%>
            <input hidden name="title" value="<%= book.title %>">
            <input hidden name="author_name" value="<%=book.author_name %>">
            <input hidden name="first_publish_year" value="<%= book.first_publish_year %>">
            <input hidden name="cover_id" value="<%= book.cover_id %>">
        <% } %>
        <input type="date" id="read_date" name="read_date" autocomplete="off">
        <label for="review">Your impression:</label>
        <textarea type="text" id="review" name="review" autofocus autocomplete="off" required placeholder="Write your review of the book"></textarea>
        <div class="rating">
            <% for (let i = 10; i >= 1; i--) { %>
                <input type="radio" id="star<%= i %>" name="rating" value="<%= i %>">
                <label for="star<%= i %>" title="<%= i %> stars">★</label>
            <% } %>
        </div>
        <button type="submit" >Add to read</button>
    </form>
</div>

<%- include("partials/footer.ejs") %>
