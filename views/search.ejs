<%- include("partials/header.ejs") %>

<div class="search_results">
    <h1>Search results</h1>
    <br>
</div>
<div class="books">
    <% if (locals.result) { %>
        <% for (let res of result) { %>
            <div class="book_card">
                <h2><%= res.title %></h2>
                <% if (res.cover_i) { %>
                    <img class="cover_img" src="https://covers.openlibrary.org/b/id/<%= res.cover_i %>-M.jpg"/>
                <% } else { %>
                    <div class="no-image">No Image</div>
                <% } %>
                <p><%= res.author_name ? res.author_name : "Unknown Author" %>, <%= res.first_publish_year %></p>
                <form action="/new" method="get" class="resultForm">
                    <input type="hidden" name="title" value="<%= res.title %>">
                    <input type="hidden" name="author_name" value="<%= res.author_name %>">
                    <input type="hidden" name="first_publish_year" value="<%= res.first_publish_year %>">
                    <input type="hidden" name="cover_id" value="<%= res.cover_i %>">
                    <button type="submit">Add Book to read list</button>
                </form>
            </div>
        <% } %>
    <% } %>
</div>

<%- include("partials/footer.ejs") %>
